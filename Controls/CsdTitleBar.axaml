<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tasks.Controls"
             x:Class="Tasks.Controls.CsdTitleBar"
             Height="44">

    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" x:Name="TitleBarGrid">
        <!-- Left Buttons -->
        <StackPanel Grid.Column="0"
                    x:Name="LeftButtonsPanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="8,0"/>

        <!-- Drag & Title Area -->
        <Panel Grid.Column="1"
               x:Name="DragArea"
               Background="Transparent">
            <TextBlock x:Name="TitleText"
                       Text=""
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="13"
                       Opacity="0.9"/>
        </Panel>

        <!-- Right Buttons -->
        <StackPanel Grid.Column="2"
                    x:Name="RightButtonsPanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0"/>
    </Grid>
</UserControl>
